{
	"name": "obsidian-terminal-agents",
	"version": "0.1.0",
	"description": "Embedded Ghostty terminal pane with live vault context for agents (Claude Code, etc.).",
	"main": "main.js",
	"scripts": {
		"build": "bun build main.ts --outfile=main.js --target=node --format=cjs --external=obsidian --external=electron",
		"dev": "bun build main.ts --outfile=main.js --target=node --format=cjs --external=obsidian --external=electron --watch",
		"lint": "eslint ."
	},
	"dependencies": {
		"ghostty-web": "^0.4.0"
	},
	"devDependencies": {
		"@types/bun": "^1.1.0",
		"@types/node": "^20",
		"obsidian": "latest",
		"typescript": "5.5.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yolo-sam/obsidian-terminal-agents.git"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"terminal",
		"ghostty",
		"agents",
		"claude-code"
	],
	"author": "smcllns",
	"license": "MIT",
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/yolo-sam/obsidian-terminal-agents/issues"
	},
	"homepage": "https://github.com/yolo-sam/obsidian-terminal-agents#readme"
}
